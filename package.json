{
  "name": "wallcal-card",
  "version": "0.4.1",
  "description": "Week-view wall calendar card for Home Assistant, with moon phase and cycle overlays",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TFoxik/wallcal.git"
  },
  "homepage": "https://github.com/TFoxik/wallcal#readme",
  "bugs": {
    "url": "https://github.com/TFoxik/wallcal/issues"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/Prague vitest run",
    "test:watch": "TZ=Europe/Prague vitest",
    "screenshots": "node dev/screenshots.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    }
  }
}
